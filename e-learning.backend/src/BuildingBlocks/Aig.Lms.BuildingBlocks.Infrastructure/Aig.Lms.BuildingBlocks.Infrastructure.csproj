<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PreserveCompilationContext>true</PreserveCompilationContext>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
      <PackageReference Include="Minio" Version="7.0.0" />
      <PackageReference Include="MailKit" Version="4.*" />
      <PackageReference Include="FluentEmail.Razor" Version="3.*" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
      <PackageReference Include="Dapper" Version="2.1.0" />
      <PackageReference Include="Npgsql" Version="7.2.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Aig.Lms.BuildingBlocks.Application\Aig.Lms.BuildingBlocks.Application.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="EmailTemplates\**\*">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Caching\" />
      <Folder Include="Identity\" />
      <Folder Include="Messaging\" />
      <Folder Include="Observability\" />
      <Folder Include="Persistence\" />
      <Folder Include="Storage\" />
      <Folder Include="Time\" />
    </ItemGroup>

</Project>

{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Launch API (http:5294)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-api",
            "program": "${workspaceFolder}/src/Api/Aig.Lms.Api/bin/Debug/net10.0/Aig.Lms.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/Api/Aig.Lms.Api",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5294"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": ".NET Launch API + Scalar",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-api",
            "program": "${workspaceFolder}/src/Api/Aig.Lms.Api/bin/Debug/net10.0/Aig.Lms.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/Api/Aig.Lms.Api",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5294"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/scalar"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": ".NET Attach to API Process",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "justMyCode": true
        }

    ]
}